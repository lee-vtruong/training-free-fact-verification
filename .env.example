TFFV_RETRIEVAL_CLAIMS=
TFFV_RETRIEVAL_CORPUS=
TFFV_RETRIEVAL_DATA_MANIFEST=
TFFV_EMBED_MODEL=
TFFV_EMBED_REVISION=
TFFV_EMBED_SHA256=
TFFV_RERANK_MODEL=
TFFV_RERANK_REVISION=
TFFV_RERANK_SHA256=
